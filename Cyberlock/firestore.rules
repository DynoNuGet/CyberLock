rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && (!('fotoPerfil' in request.resource.data)
                       || (request.resource.data.fotoPerfil is string && request.resource.data.fotoPerfil.size() < 150000));

      match /progresso/{jogoId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /placar/{jogoId}/jogadores/{uid} {
      function entradaValida() {
        let d = request.resource.data;
        return d.keys().hasOnly(['nome', 'pontos', 'nivelUsuario', 'atualizadoEm'])
          && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 40
          && d.pontos is number && d.pontos >= 0 && d.pontos <= 100000
          && d.nivelUsuario is number && d.nivelUsuario >= 1;
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid && entradaValida();
      allow update: if request.auth != null && request.auth.uid == uid && entradaValida()
                    && request.resource.data.pontos >= resource.data.pontos;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
